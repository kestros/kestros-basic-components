{
  "jcr:primaryType": "nt:unstructured",
  "jcr:title": "Static Panel",
  "group": "Kestros Core",
  "classPath": "io.kestros.cms.components.basic.core.structure.accordion.AccordionPanelStaticDataSource",
  "create": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/cms2/dialog",
    "defaultErrorMessage": "Failed to create child resource.",
    "successEvents": [
      "navigation",
      "component",
      "new-component"
    ],
    "actions": [
      "cancel",
      "create"
    ],
    "content": {
      "jcr:primaryType": "nt:unstructured",
      "component-type": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/kestros/component-picker",
        "label": "Component",
        "name": "sling:resourceType"
      }
    },
    "footer": {
      "jcr:primaryType": "nt:unstructured"
    }
  },
  "edit": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/cms2/dialog",
    "content": {
      "jcr:primaryType": "nt:unstructured",
      "title": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Title",
        "name": "panelTitle",
        "autofocus": true
      },
      "ariaLabel": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Aria Label",
        "name": "panelAriaLabel",
        "autofocus": false
      },
      "expended": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/checkbox",
        "label": "Expanded on Load",
        "name": "panelExpanded"
      },
      "disabled": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/checkbox",
        "label": "Disabled",
        "name": "panelDisabled"
      }
    }
  }
}