{
  "jcr:primaryType": "nt:unstructured",
  "jcr:title": "Static",
  "group": "Kestros Core",
  "classPath": "io.kestros.cms.components.basic.core.content.card.CardStaticDataSource",
  "container": true,
  "edit": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/cms2/dialog",
    "content": {
      "jcr:primaryType": "nt:unstructured",
      "text": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Text",
        "name": "headingText",
        "autofocus": true
      },
      "heading": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/selectfield",
        "label": "Heading Level",
        "name": "headingType",
        "options": {
          "h1": {
            "jcr:primaryType": "nt:unstructured",
            "text": "h1",
            "value": "h1",
            "selected": true
          },
          "h2": {
            "jcr:primaryType": "nt:unstructured",
            "text": "h2",
            "value": "h2",
            "selected": false
          },
          "h3": {
            "jcr:primaryType": "nt:unstructured",
            "text": "h3",
            "value": "h3",
            "selected": false
          },
          "h4": {
            "jcr:primaryType": "nt:unstructured",
            "text": "h4",
            "value": "h4",
            "selected": false
          },
          "h5": {
            "jcr:primaryType": "nt:unstructured",
            "text": "h5",
            "value": "h5",
            "selected": false
          },
          "h6": {
            "jcr:primaryType": "nt:unstructured",
            "text": "h6",
            "value": "h6",
            "selected": false
          }
        }
      },
      "description": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Description",
        "name": "description",
        "autofocus": true
      },
      "image": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/pathfield",
        "label": "Image",
        "propertyName": "imagePath",
        "resourceTypes": [
          "kes:Asset"
        ],
        "includePaths": ["/content/assets"]
      },
      "label": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Button Label",
        "name": "text",
        "autofocus": true
      },
      "href": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/pathfield",
        "label": "Button Link",
        "name": "href",
        "includePaths": [
          "closest:kes:Site"
        ],
        "resourceTypes": [
          "kes:Site",
          "kes:Page"
        ],
        "autofocus": false
      },
      "openInNewTab": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/checkbox",
        "label": "Open Button in New Tab",
        "name": "openInNewTab"
      },
      "ariaLabel": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Button Aria Label",
        "name": "ariaLabel"
      },
      "anchorTitle": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Button Title",
        "name": "title"
      }
    }
  }
}