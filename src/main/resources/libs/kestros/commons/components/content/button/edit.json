{
  "jcr:primaryType": "nt:unstructured",
  "sling:resourceType": "kestros/cms/dialog",
  "jcr:title": "Edit",
  "content-area": {
    "jcr:primaryType": "nt:unstructured",
    "tabs": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms/general/tabs",
      "container": true,
      "general": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms/general/container",
        "jcr:title": "General",
        "container": true,
        "label": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Label",
          "propertyName": "label",
          "autofocus": true
        },

        "href": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/url-field",
          "label": "Link",
          "propertyName": "href",
          "rootPath": "/content/sites",
          "resourceTypes": [
            "kes:Site",
            "kes:Page"
          ],
          "autofocus": false
        },
        "ariaLabel": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Aria Label",
          "propertyName": "ariaLabel"
        },
        "anchorTitle": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Anchor Title",
          "propertyName": "anchorTitle"
        }
      }
    }
  }
}
