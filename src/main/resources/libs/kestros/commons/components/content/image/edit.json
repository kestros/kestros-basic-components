{
  "jcr:primaryType": "nt:unstructured",
  "sling:resourceType": "kestros/cms/dialog",
  "jcr:title": "Edit",
  "content-area": {
    "jcr:primaryType": "nt:unstructured",
    "tabs": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms/general/tabs",
      "container": true,
      "general": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms/general/container",
        "jcr:title": "General",
        "container": true,
        "image": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/pathfield",
          "label": "Image",
          "propertyName": "imagePath",
          "resourceTypes": [
            "kes:Asset"
          ],
          "matchType": "startsWith",
          "rootPath": "/content/assets",
          "required": true
        },
        "alt-text": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Alt Text",
          "propertyName": "altText"
        },
        "caption": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Caption",
          "propertyName": "caption"
        },
        "href": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/pathfield",
          "label": "Link URL",
          "propertyName": "href",
          "resourceTypes": [
            "kes:Site",
            "kes:Page"
          ],
          "rootPath": "/content/sites"
        },
        "ariaLabel": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Aria Label",
          "propertyName": "ariaLabel"
        },
        "anchorTitle": {
          "jcr:primaryType": "nt:unstructured",
          "sling:resourceType": "kestros/cms/fields/textfield",
          "label": "Anchor Title",
          "propertyName": "anchorTitle"
        }
      }
    }
  }
}
