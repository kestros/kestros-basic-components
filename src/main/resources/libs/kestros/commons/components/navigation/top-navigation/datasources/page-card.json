        "includePaths": [
          "closest:kes:Site"
        ]
      },
      "buttonLabel": {
        "jcr:primaryType": "nt:unstructured",
        "sling:resourceType": "kestros/cms2/fields/general/textfield",
        "label": "Button Label",
        "name": "buttonLabel",
        "autofocus": true
      }
    }
  }
