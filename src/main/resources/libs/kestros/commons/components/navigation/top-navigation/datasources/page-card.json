  "container": true,
  "edit": {
    "jcr:primaryType": "nt:unstructured",
    "sling:resourceType": "kestros/cms2/dialog",
    "content": {
      "jcr:primaryType": "nt:unstructured",
      "page": {
        "jcr:primaryType": "nt:unstructured",
