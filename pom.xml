<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.kestros.cms</groupId>
        <artifactId>kestros-site-parent</artifactId>
        <version>0.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.kestros.cms</groupId>
    <artifactId>kestros-basic-components-parent</artifactId>
    <version>0.3.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kestros Basic Components (Reactor)</name>
    <description>Aggregator for the Kestros Basic Components bundle and its shared test-support module.</description>

    <licenses>
        <license>
            <name>GPL-v3.0</name>
            <url>http://www.gnu.org/licenses/gpl-3.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/kestros/kestros-basic-components.git</connection>
        <developerConnection>scm:git:ssh://github.com:kestros/kestros-basic-components.git
        </developerConnection>
        <url>https://github.com/kestros/kestros-basic-components/tree/master</url>
    </scm>

    <modules>
        <module>kestros-basic-components</module>
        <module>kestros-basic-components-testing</module>
    </modules>

    <profiles>
        <profile>
            <id>strict</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.rat</groupId>
                        <artifactId>apache-rat-plugin</artifactId>
                        <version>0.13</version>
                        <configuration>
                            <excludes>
                                <!-- don't check anything in target -->
                                <exclude>target/*</exclude>
                                <!-- Fixing issues with deleted modules -->
                                <exclude>**/target/*</exclude>
                                <exclude>**/target/**/*</exclude>
                                <exclude>**/*.json</exclude>
                                <exclude>node/**/*</exclude>
                                <exclude>node_modules/**/*</exclude>
                                <exclude>**/README.md</exclude>
                                <exclude>package.json</exclude>
                                <exclude>package-lock.json</exclude>
                                <exclude>*-maven-settings.xml</exclude>
                                <exclude>src/main/resources/content/ROOT.json</exclude>
                                <exclude>src/main/resources/startup/favicon.svg</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
